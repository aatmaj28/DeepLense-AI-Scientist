# Copy to .env and edit. NEVER commit your real .env (it is gitignored).
# All variables are optional; defaults target a local Ollama server.

# --- Local model selection (model-agnostic, local-first) ---
# provider: ollama | vllm | llamacpp | openai | openai_compatible
DLENS_MODEL_PROVIDER=ollama

# Default qwen3:8b (~5.2 GB) runs on a single workstation GPU and supports tools.
#   Smaller GPU:  qwen3:4b (~2.5 GB)
#   Bigger GPU :  qwen3:14b (~9.3 GB), qwen3:32b (~20 GB)
#   Stronger reasoning (recommended alternative): gpt-oss:20b (~14 GB)
DLENS_MODEL=qwen3:8b

# Port for local servers (defaults: ollama 11434, vllm 8000, llamacpp 8080)
# DLENS_MODEL_PORT=11434

# --- Shared / remote OpenAI-compatible endpoint (provider=openai_compatible) ---
# For a shared vLLM gateway or OpenRouter (e.g. a shared key provided later).
# DLENS_MODEL_BASE_URL=https://your-gateway/v1
# DLENS_MODEL_API_KEY=...
# (OPENAI_API_KEY is also honored as a fallback for the key.)

# ---------------------------------------------------------------------------
# Examples
#   Local gpt-oss:        DLENS_MODEL=gpt-oss:20b
#   Local vLLM server:    DLENS_MODEL_PROVIDER=vllm   DLENS_MODEL=Qwen/Qwen3-8B
#   Shared OpenRouter:    DLENS_MODEL_PROVIDER=openai_compatible
#                         DLENS_MODEL=qwen/qwen3-8b
#                         DLENS_MODEL_BASE_URL=https://openrouter.ai/api/v1
#                         DLENS_MODEL_API_KEY=sk-or-...
